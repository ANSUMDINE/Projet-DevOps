pipeline {
    agent any
    stages {
        stage('supprimer le workspace') {
            steps {
                deleteDir()
            }
        }
        stage('Checkout SCM') {
            steps {
                sh 'https://github.com/ANSUMDINE/Projet-DevOps.git'
            }
        }
        stage('Build image docker') {
            steps {
                sh 'docker build -t myimage_nginx .'
                sh 'docker tag myimage_nginx said:myimage_nginx'
            }
        }
        stage('Tag image docker') {
            steps {
                sh 'docker tag myimage_nginx said:myimage_nginx'
            }
        }
        stage('Deploiement application') {
            steps {
                sh 'docker rm image mynginx'
                sh 'docker rm -f $(docker ps -a)'
                sh 'docker run -d --name monapp --hostname monapp -p 8999:80 myimage_nginx'
            }
        }
    }
}
